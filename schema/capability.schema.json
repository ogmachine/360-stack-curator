{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "description",
    "relatedRepos"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "relatedRepos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parentCapability": { "type": ["string", "null"] },
    "agentSupport": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    }
  },
  "additionalProperties": true
}
