{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent",
  "type": "object",
  "required": [
    "name",
    "type",
    "supports",
    "connectors",
    "bestFor"
  ],
  "properties": {
    "name": { "type": "string" },
    "type": { "type": "string" },
    "supports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "connectors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bestFor": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
